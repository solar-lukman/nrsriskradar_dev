    RISKS {
        uuid id PK
        text risk_reference "generate_risk_reference()"
        risk_type risk_type "institutional | compliance"
        risk_category category "synced from risk_categories"
        int inherent_likelihood
        int inherent_impact
        int residual_likelihood
        int residual_impact
        risk_status status "lifecycle"
        approval_status approval_status "governance, orthogonal"
        uuid owner_id FK
        uuid current_reviewer_id
        numeric mitigation_budget
        text mitigation_budget_currency "NGN default"
    }
    RISK_ASSESSMENTS {
        uuid id PK
        uuid risk_id FK
        uuid template_id FK
        int likelihood
        int impact
        jsonb answers
    }
    RISK_MITIGATION_TASKS {
        uuid id PK
        uuid risk_id FK
        text status "guarded by transition trigger"
        date due_date
    }
    RISK_HISTORY {
        uuid id PK
        uuid risk_id FK
        jsonb snapshot "append-only"
        text change_type
    }
    APPROVAL_HISTORY {
        uuid id PK
        uuid risk_id FK
        approval_status from_status
        approval_status to_status
        uuid actor_id
    }
